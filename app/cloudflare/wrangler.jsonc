{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "layer-prettify",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "vars": { "ALLOWED_ORIGIN": "https://mylo1908.github.io" },
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  "observability": { "enabled": false }
}
